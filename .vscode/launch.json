    "version": "0.2.0",
    "configurations": [
    {
        "name": "Blinking Led",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/bin/Pc32/debug/blinking-led.elf",
        "args": [],
        "stopAtEntry": false,
        "cwd": "${fileDirname}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
            {
                "description": "Włącz formatowanie kodu dla gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "Ustaw wariant dezasemblacji na Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ]
    },
