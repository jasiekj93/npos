..
.\" Punktacja z pogrubieniem podmiotu
.de IP_bold
.  IP "\fB\\$1\fP"
..
.\" Punktacja z interliną podmiotu
.de IP_italic
.  IP "\fI\\$1\fP"
..
.\"Rozdział z wpisem do spisu treści
.de chapter
